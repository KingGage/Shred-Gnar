   <property name="styleSheet">
    <string notr="true">QPushButton#startButton {
    /* Text */
    color: #FFFFFF;
    text-transform: uppercase;        /* Qt ignores this but we’ll set text in code too */
    font-family: &quot;Press Start 2P&quot;, &quot;Pixel Arial 11&quot;, &quot;Monospace&quot;;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 2px;

    /* Size / padding */
    padding: 6px 28px;
    min-height: 32px;

    /* Button body – dark navy with slight vertical gradient */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #243764,
        stop:1 #1B2C56
    );

    /* White outline like in the pixel art */
    border-style: solid;
    border-width: 3px;
    border-color: #FFFFFF;
    border-radius: 8px;

    /* Remove default focus rectangle */
    outline: none;
}

/* Hover – slightly brighter */
QPushButton#startButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #2c447b,
        stop:1 #243764
    );
}

/* Pressed – darker and “pushed down” effect */
QPushButton#startButton:pressed {
    background-color: #111B33;
    padding-top: 8px;      /* move text down a bit */
    padding-bottom: 4px;
}</string>
