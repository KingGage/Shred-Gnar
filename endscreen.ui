   <property name="styleSheet">
    <string notr="true">QPushButton#playAgainButton {
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;SF Pro Text&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 12pt;
    font-weight: 600;
    letter-spacing: 1px;

    padding: 6px 28px;   /* a bit wider for Start */
    min-height: 32px;

    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #3b65b3,
        stop:1 #2b4f8a
    );

    border: 2px solid #ffffff;
    border-radius: 8px;

    border-top-color: #dfe9ff;
    border-left-color: #dfe9ff;
    border-right-color: #1b315c;
    border-bottom-color: #1b315c;

    outline: none;
}

QPushButton#playAgainButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a79cf,
        stop:1 #355fa4
    );
}

QPushButton#playAgainButton:pressed {
    background-color: #223a66;
    padding-top: 8px;
    padding-bottom: 4px;
}
</string>
