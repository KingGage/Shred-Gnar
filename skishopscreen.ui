/* Hover – brighten like it’s catching more light */
QPushButton#powderSkiButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #c98245,
        stop:0.5 #a55a30,
        stop:1 #6a351a
    );
}

/* Pressed – darker + “pressed in” bevel */
QPushButton#powderSkiButton:pressed {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #8a502a,
        stop:1 #4a2410
    );

    border-top-color:    #3b1d0e;
    border-left-color:   #3b1d0e;
    border-right-color:  #d18a4e;
    border-bottom-color: #e3a465;

    margin-top: 3px;   /* tiny nudge down */
    margin-left: 3px;
}</string>
      </property>
      <property name="text">
       <string/>
      </property>
      <property name="icon">
       <iconset resource="ShredGnarResources.qrc">
        <normaloff>:/skiSprites/a9_Resources/skiSprites/LockedGreenSkis.png</normaloff>:/skiSprites/a9_Resources/skiSprites/LockedGreenSkis.png</iconset>
      </property>
