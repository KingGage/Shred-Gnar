  <widget class="QPushButton" name="shredGnarButton">
   <property name="geometry">
    <rect>
     <x>530</x>
     <y>680</y>
     <width>210</width>
     <height>48</height>
    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">QPushButton#shredGnarButton {
    /* Text */
    color: #FFFFFF;
    font-family: &quot;Press Start 2P&quot;, &quot;Pixel Arial 11&quot;, &quot;Monospace&quot;;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 2px;

    /* Size / padding – slightly shorter than startButton */
    padding: 6px 16px;      /* was 28px horizontally */
    min-height: 30px;

    /* Button body – same navy gradient */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #243764,
        stop:1 #1B2C56
    );
}

QPushButton#shredGnarButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #2c447b,
        stop:1 #243764
    );
}

QPushButton#shredGnarButton:pressed {
    background-color: #111B33;
    padding-top: 8px;
    padding-bottom: 4px;
}</string>
   </property>
   <property name="text">
    <string>SHRED SOME GNAR</string>
   </property>
  </widget>
  <widget class="QWidget" name="gridLayoutWidget">
   <property name="geometry">
    <rect>
     <x>20</x>
     <y>240</y>
     <width>200</width>
     <height>380</height>
    </rect>
   </property>
   <layout class="QGridLayout" name="gridLayout">
    <item row="3" column="0">
     <widget class="QPushButton" name="touringSkiButton">
      <property name="enabled">
       <bool>true</bool>
      </property>
      <property name="styleSheet">
       <string notr="true">QPushButton#touringSkiButton{
    /* Square tile shape */
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;
    padding: 0;
    border-radius: 4px;           /* soften just a bit, set 0 for strict pixel square */

    /* Text/icon color (if you show anything on it) */
    color: #fdf5e6;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 10pt;
    font-weight: bold;

/* Make the icon fill the whole button */
    qproperty-iconSize: 64px 64px;

    border-radius: 4px;

    /* Wood plank feel: warm vertical gradient */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #b8703a,    /* lighter top */
        stop:0.5 #8c4b26,  /* mid brown */
        stop:1 #5b2f16     /* darker bottom */
    );

    /* Beveled “tile” border to match cabin walls */
    border-style: solid;
    border-width: 3px;
    border-top-color:    #e3a465;   /* highlight */
    border-left-color:   #d18a4e;
    border-right-color:  #3b1d0e;   /* shadow */
    border-bottom-color: #2a1309;

    /* Slight drop shadow look using margin */
    margin-top: 2px;
    margin-left: 2px;

    outline: none;
}

/* Hover – brighten like it’s catching more light */
QPushButton#touringSkiButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #c98245,
        stop:0.5 #a55a30,
        stop:1 #6a351a
    );
}

/* Pressed – darker + “pressed in” bevel */
QPushButton#touringSkiButton:pressed {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #8a502a,
        stop:1 #4a2410
    );

    border-top-color:    #3b1d0e;
    border-left-color:   #3b1d0e;
    border-right-color:  #d18a4e;
    border-bottom-color: #e3a465;

    margin-top: 3px;   /* tiny nudge down */
    margin-left: 3px;
}</string>
      </property>
      <property name="text">
       <string/>
      </property>
      <property name="icon">
       <iconset resource="ShredGnarResources.qrc">
        <normaloff>:/skiSprites/a9_Resources/skiSprites/LockedGreenLightningSkis.png</normaloff>:/skiSprites/a9_Resources/skiSprites/LockedGreenLightningSkis.png</iconset>
      </property>
     </widget>
    </item>
