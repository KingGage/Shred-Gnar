   <property name="styleSheet">
    <string notr="true">QPushButton#nextButton {
    /* Text */
    color: #FFFFFF;
    font-family: &quot;Press Start 2P&quot;, &quot;Pixel Arial 11&quot;, &quot;Monospace&quot;;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 2px;

    /* Size / padding – slightly shorter than startButton */
    padding: 6px 16px;      /* was 28px horizontally */
    min-height: 30px;

    /* Button body – same navy gradient */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #243764,
        stop:1 #1B2C56
    );

    /* White outline */
    border-style: solid;
    border-width: 3px;
    border-color: #FFFFFF;
    border-radius: 8px;

    outline: none;
}

QPushButton#nextButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #2c447b,
        stop:1 #243764
    );
}

QPushButton#nextButton:pressed {
    background-color: #111B33;
    padding-top: 8px;
    padding-bottom: 4px;
}</string>
