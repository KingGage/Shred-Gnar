/* Generic QPushButton style */
QPushButton {
    /* Text */
    color: #ffffff;
    font-family: "Segoe UI", "SF Pro Text", "Arial", sans-serif;
    font-size: 12pt;
    font-weight: 600;
    letter-spacing: 1px;

    /* Size / padding */
    padding: 6px 18px;
    min-height: 30px;

    /* Background */
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #3b65b3,
        stop:1 #2b4f8a
    );

    /* Border */
    border: 2px solid #ffffff;
    border-radius: 8px;

    /* Shadow-ish effect via inner border */
    border-top-color: #dfe9ff;
    border-left-color: #dfe9ff;
    border-right-color: #1b315c;
    border-bottom-color: #1b315c;

    /* Remove default focus rect */
    outline: none;
}

/* Hover: slightly brighter */
QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a79cf,
        stop:1 #355fa4
    );
}

/* Pressed: darker + “pressed in” padding tweak */
QPushButton:pressed {
    background-color: #223a66;
    padding-top: 8px;
    padding-bottom: 4px;
}

/* Disabled: muted colors */
QPushButton:disabled {
    background-color: #555a68;
    border-color: #888c98;
    color: #c0c3cc;
}
